{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>USA-RedDragon/renovate-configs"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*Dockerfile$/"
      ],
      "matchStrings": [
        "ARG UCODE_VERSION=(?<currentDigest>.*?)\\n"
      ],
      "currentValueTemplate": "master",
      "depNameTemplate": "ucode",
      "packageNameTemplate": "https://github.com/jow-/ucode",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*Dockerfile$/"
      ],
      "matchStrings": [
        "ARG OLSRD_VERSION=(?<currentDigest>.*?)\\n"
      ],
      "currentValueTemplate": "aredn",
      "depNameTemplate": "olsrd",
      "packageNameTemplate": "https://github.com/USA-RedDragon/olsrd",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*Dockerfile$/"
      ],
      "matchStrings": [
        "ARG BABELD_VERSION=(?<currentDigest>.*?)\\n"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "babeld",
      "packageNameTemplate": "https://github.com/USA-RedDragon/babeld",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "Deps extracted by regex from .version.sh have nowhere to write a digest; pinning them poisons the shared pin branch",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "matchPackageNames": [
        "docker.io/alpine",
        "alpine"
      ],
      "allowedVersions": "<2018.0.0"
    },
    {
      "matchDatasources": [
        "git-tags"
      ],
      "matchPackageNames": [
        "https://thekelleys.org.uk/git/dnsmasq.git"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)(?<compatibility>[a-zA-Z]+)?(?<patch>\\d+)?$"
    },
    {
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "indilib/indi-3rdparty",
        "indilib/indi"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\.(?<build>\\d+))?$"
    },
    {
      "description": "One automerge PR per image: CI builds per changed image directory, so a group per directory is one build per round",
      "matchFileNames": [
        "images/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "groupName": "{{parentDir}}"
    },
    {
      "description": "One automerge PR for all workflow action bumps",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "groupName": "github-actions"
    }
  ]
}
